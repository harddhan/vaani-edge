# Copy to .env and adjust as needed. Most configuration lives in
# configs/*.yaml; this file covers secrets/host-specific values that
# should not be committed.

# LAN address of the machine running `python -m server.main`.
# Also set configs/network.yaml -> network.server_address_for_client
# and firmware/esp32s3/main/app_config.h -> kServerHost to match.
SERVER_HOST=192.168.1.100
SERVER_PORT=8765

# Wi-Fi credentials for the ESP32 firmware (placeholder - the hardware
# teammate should move these to NVS/provisioning for anything beyond a
# lab demo; do not commit real credentials).
WIFI_SSID=REPLACE_ME_SSID
WIFI_PASSWORD=REPLACE_ME_PASSWORD

# Optional local ASR backend selection: "mock" or "local_whisper"
ASR_BACKEND=mock
